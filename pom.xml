<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.allgemein</groupId>
  <artifactId>transaktionssteuerung</artifactId>
  <version>0.5.8</version>
  <packaging>jar</packaging>

  <name>Transaktionssteuerung</name>
  <description>Eigene Transaktionssteuerung (TP-Monitor-Ersatz) für Java und Oracle, inkl. Leistungsmanagement Grundsicherung (SDN.Leistung-LMG)</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <exec.mainClass>de.allgemein.tx.demo.DemoMain</exec.mainClass>
  </properties>

  <dependencies>
    <!-- Oracle-JDBC-Treiber; nur zur Laufzeit benötigt (Treiber registriert sich per SPI) -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>23.5.0.24.07</version>
    </dependency>

    <!-- Oracle Universal Connection Pool (UCP) -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ucp</artifactId>
      <version>23.5.0.24.07</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
        <executions>
          <execution><id>evidence-test-begin</id><phase>initialize</phase><goals><goal>exec</goal></goals>
            <configuration><executable>java</executable><arguments><argument>${project.basedir}/tools/BuildStamp.java</argument><argument>test-begin</argument><argument>${project.basedir}</argument><argument>main</argument><argument>${settings.localRepository}</argument></arguments></configuration>
          </execution>
          <execution><id>evidence-build-stamp</id><phase>process-classes</phase><goals><goal>exec</goal></goals>
            <configuration><executable>java</executable><arguments><argument>${project.basedir}/tools/BuildStamp.java</argument><argument>stamp</argument><argument>${project.basedir}</argument><argument>main</argument></arguments></configuration>
          </execution>
          <execution><id>evidence-test-finish</id><phase>test</phase><goals><goal>exec</goal></goals>
            <configuration><executable>java</executable><arguments><argument>${project.basedir}/tools/BuildStamp.java</argument><argument>test-finish</argument><argument>${project.basedir}</argument><argument>main</argument><argument>${settings.localRepository}</argument></arguments></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
