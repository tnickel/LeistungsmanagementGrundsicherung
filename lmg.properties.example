# ==============================================================================
# SDN.sozial (LMG) — Vorlage für die Konfigurationsdatei
# Nach lmg.properties kopieren und an die eigene Umgebung anpassen.
# Priorität: System Properties (-D...) > Umgebungsvariablen (LMG_*) > lmg.properties
# lmg.properties enthält Zugangsdaten und wird NICHT eingecheckt (.gitignore).
# ==============================================================================

# Datenbankverbindung: Standard ist die Entwickler-DB im Docker-Container
# "lmg-oracle" (Oracle Free; start.bat fährt ihn bei Bedarf hoch).
# Alternativ Oracle 19c EE in VirtualBox: jdbc:oracle:thin:@//localhost:1921/o19c1p1
tx.url=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
tx.user=tx_demo
tx.pass=tx_demo

# Web-Server Port
lmg.port=8080

# Verbindungspool (ucp oder simple) und Dimensionierung
lmg.pool.type=ucp
lmg.pool.size=8

# Task-Controller (Parallele Transaktionen & Warteschlange)
lmg.tasks.max=8
lmg.tasks.queue=100

# Audit-Logdatei für revisionssichere Nachvollziehbarkeit (leer lassen für nur Konsolen-/Logger-Ausgabe)
lmg.audit.file=lmg_audit.log

# Benutzerkonten (Format: kennung:passwort:rolle, Einträge DURCH SEMIKOLON getrennt;
# Rollen: admin oder sachbearbeiter)
# Wenn nicht gesetzt, sind Standard-Demo-Konten aktiv (admin-01/admin, sb-01/sb-01, sb-02/sb-02)
# lmg.benutzer=admin-01:geheim123:admin;sb-01:geheim456:sachbearbeiter

# Sitzungen laufen nach dieser Idle-Zeit ab (Minuten)
lmg.session.timeout.minuten=60

# KdU-Prüfung (§ 42a i.V.m. § 35 SGB XII): 0 = deaktiviert
#  - warmwasserabzug: örtlicher Warmwasseranteil an den Heizkosten bei ZENTRALER Erzeugung
#    (§ 35 Abs. 5; Dezimalanteil, z. B. 0.10 für 10 %). Wird nur abgezogen, wenn der Fall
#    NICHT dezentral erzeugt (dann gilt stattdessen der Mehrbedarf nach § 30 Abs. 7).
#  - angemessenheitsgrenze: monatliche Obergrenze der KdU je BEDARFSGEMEINSCHAFT in EUR
#    (§ 35 Abs. 7); darüber hinausgehende Kosten werden nicht berücksichtigt und im Bescheid
#    mit * gekennzeichnet. Karenzzeit und Absenkungsfrist (§ 35 Abs. 1/3) sind NICHT abgebildet.
lmg.kdu.warmwasserabzug=0
lmg.kdu.angemessenheitsgrenze=0

# Rechtsbehelfsbelehrung der Bescheide (§ 36 SGB X): WIDERSPRUCH oder KLAGE —
# je nach Träger/Landesrecht (§ 78 bzw. § 87 Abs. 1 SGG)
lmg.rechtsbehelf.modus=WIDERSPRUCH
# lmg.rechtsbehelf.behoerde=Stadt Musterstadt, Amt für Soziales und Wohnen, Musterstraße 1, 12345 Musterstadt
# lmg.rechtsbehelf.sozialgericht=Sozialgericht Musterstadt, Musterstraße 2, 12345 Musterstadt
# lmg.behoerde.ort=Musterstadt
# lmg.behoerde.anschrift=Stadt Musterstadt, Amt für Soziales und Wohnen, Musterstraße 1, 12345 Musterstadt
