<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.allgemein</groupId>
  <artifactId>testsweet</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>testsweet — Mitarbeiter-Simulator für SDN.Leistung LMG</name>
  <description>
    Eigenständiger Simulator (keine Unit-Tests): N Sachbearbeiter arbeiten parallel einen
    Pool von Anwenderszenarien über die Fachschicht des Leistungsmanagements ab.
    Modus 1 = Transaktionstest über die Fachschicht; Modus 2 = Weboberfläche/Selenium
    (vorgesehen, Schritt 2). Alles wird für die manuelle Auswertung mitgeloggt.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <exec.mainClass>de.allgemein.testsweet.SweetMain</exec.mainClass>
  </properties>

  <dependencies>
    <!-- Fachschicht + Transaktionskern des Hauptprojekts (inkl. ojdbc11/ucp transitiv).
         Voraussetzung: einmalig `mvn install` im Hauptprojekt (Version muss übereinstimmen). -->
    <dependency>
      <groupId>de.allgemein</groupId>
      <artifactId>transaktionssteuerung</artifactId>
      <version>0.5.8</version>
    </dependency>

    <!-- Modus 2: Selenium steuert sichtbare Chrome-Fenster, die die echte
         SDN.Leistung-Weboberfläche bedienen (10 Fenster nebeneinander). -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>4.27.0</version>
    </dependency>
    <dependency>
      <groupId>io.github.bonigarcia</groupId>
      <artifactId>webdrivermanager</artifactId>
      <version>5.9.0</version>
    </dependency>

    <!-- Unit-Tests des Simulators selbst (gleiche Version wie im Hauptprojekt). -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
        <executions>
          <execution><id>evidence-test-begin</id><phase>initialize</phase><goals><goal>exec</goal></goals>
            <configuration><executable>java</executable><arguments><argument>${project.basedir}/../tools/BuildStamp.java</argument><argument>test-begin</argument><argument>${project.basedir}/..</argument><argument>testsweet</argument><argument>${settings.localRepository}</argument></arguments></configuration>
          </execution>
          <execution><id>evidence-build-stamp</id><phase>process-classes</phase><goals><goal>exec</goal></goals>
            <configuration><executable>java</executable><arguments><argument>${project.basedir}/../tools/BuildStamp.java</argument><argument>stamp</argument><argument>${project.basedir}/..</argument><argument>testsweet</argument></arguments></configuration>
          </execution>
          <execution><id>evidence-test-finish</id><phase>test</phase><goals><goal>exec</goal></goals>
            <configuration><executable>java</executable><arguments><argument>${project.basedir}/../tools/BuildStamp.java</argument><argument>test-finish</argument><argument>${project.basedir}/..</argument><argument>testsweet</argument><argument>${settings.localRepository}</argument></arguments></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
